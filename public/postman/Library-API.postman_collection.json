{
  "info": {
    "name": "Library API",
    "description": "REST API проекта «Библиотека». Перед запуском поднимите сервер: php artisan serve.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// return_date всегда «через 14 дней», чтобы запрос выдачи не устаревал",
          "const d = new Date(); d.setDate(d.getDate() + 14);",
          "pm.collectionVariables.set('return_date', d.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "return_date",
      "value": ""
    }
  ],
  "item": [
